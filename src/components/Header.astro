---
const { path = '' } = Astro.props;
const links = [
  { href: '/metodo', label: 'Il metodo' },
  { href: '/settori', label: 'Settori' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/contatti', label: 'Contatti' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true"></span>
      Reparto Tecnologico
      <span class="by">Giamor Group</span>
    </a>
    <nav class="site-nav" aria-label="Navigazione principale">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="tel" href="tel:+39XXXXXXXXX">+39 XXX XXX XXXX</a>
    </nav>
    <a class="header-tel-mobile" href="tel:+39XXXXXXXXX" aria-label="Chiama lo studio">Chiama</a>
  </div>
  <nav class="mobile-nav" aria-label="Navigazione principale (mobile)">
    <div class="mobile-nav-track">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
  </nav>
</header>
