---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const settori = [
  {
    href: '/settori/studi-dentistici',
    titolo: 'Studi dentistici',
    testo:
      'Gestionale, radiologia digitale, richiami pazienti, telefono che squilla mentre sei in poltrona.',
  },
  {
    href: '/settori/studi-medici',
    titolo: 'Studi medici e poliambulatori',
    testo:
      'Cartella clinica, refertazione, prenotazioni, dati sanitari da trattare a norma.',
  },
  {
    href: '/settori/case-di-riposo',
    titolo: 'Case di riposo e RSA',
    testo:
      'Turni su tre fasce, wifi per ospiti e familiari, chiamate infermieri, continuità 24 ore.',
  },
  {
    href: '/settori/studi-notarili',
    titolo: 'Studi notarili',
    testo:
      'Firma digitale, repertori, conservazione a norma, riservatezza degli atti.',
  },
  {
    href: '/settori/studi-commercialisti',
    titolo: 'Studi commercialisti',
    testo:
      'Gestionali fiscali, scadenze che non ammettono fermi, archivio documentale che cresce.',
  },
  {
    href: '/settori/studi-legali',
    titolo: 'Studi legali',
    testo:
      'Processo telematico, riservatezza del fascicolo, lavoro fuori studio e in udienza.',
  },
  {
    href: '/settori/onoranze-funebri',
    titolo: 'Onoranze funebri',
    testo:
      'Reperibilità continua, chiamate che non possono restare senza risposta, squadre in movimento.',
  },
];
---

<Base
  title="Reparto Tecnologico — Il tuo reparto IT a canone unico | Giamor Group"
  description="Servizi IT gestiti a canone unico per studi e strutture professionali: assistenza, sicurezza, reti, telefonia, cloud e automazioni di studio. Un contratto, un interlocutore, una fattura. Un appuntamento e hai il preventivo."
  path="/"
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Servizi IT gestiti · studi e strutture professionali</span>
        <h1>Il tuo reparto tecnologico, <em>senza assumere nessuno</em>.</h1>
        <p class="lead" style="margin-top:1.5rem;">
          Computer, rete, telefoni, sicurezza, backup, conformità: tutto gestito
          da noi, tutto dentro un canone mensile. Un numero da chiamare quando
          qualcosa non va, e nessuna fattura a sorpresa.
        </p>
        <div class="actions">
          <a class="btn" href="/contatti">Prenota l'appuntamento di raccolta requisiti</a>
          <a class="btn-quiet" href="/metodo">Come funziona il canone</a>
        </div>
        <p class="cta-note">
          Un incontro. Poi il preventivo, con il canone e l'elenco di cosa
          comprende.
        </p>
      </div>

      <!-- Elemento firma: la lista che diventa un canone -->
      <div class="ledger reveal">
        <div class="ledger-head">
          <span>Nel canone mensile</span>
          <span>Studio tipo</span>
        </div>
        <div class="ledger-body">
          <p class="ledger-group">Postazioni e persone</p>
          <div class="ledger-row"><span>Assistenza remota e in studio</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Manutenzione e aggiornamenti</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Monitoraggio continuo dei sistemi</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Microsoft 365 e posta</span><span class="dots"></span><span class="mark">incl.</span></div>

          <p class="ledger-group">Rete e comunicazione</p>
          <div class="ledger-row"><span>Connettività e rete di studio</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Centralino e telefonia</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Wi-Fi per operatori e ospiti</span><span class="dots"></span><span class="mark">incl.</span></div>

          <p class="ledger-group">Sicurezza e dati</p>
          <div class="ledger-row"><span>Firewall e protezione della rete</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Antivirus gestito su ogni dispositivo</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Backup verificato e ripristino</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Supporto alla conformità (GDPR, NIS2)</span><span class="dots"></span><span class="mark">incl.</span></div>

          <p class="ledger-group">Dispositivi</p>
          <div class="ledger-row"><span>Computer, server e apparati a noleggio</span><span class="dots"></span><span class="mark">incl.</span></div>
          <div class="ledger-row"><span>Sostituzione in caso di guasto</span><span class="dots"></span><span class="mark">incl.</span></div>
        </div>
        <div class="ledger-total">
          <span class="label">Un canone mensile</span>
          <span class="value">una sola fattura</span>
        </div>
        <p class="ledger-foot">
          Fuori canone soltanto due voci, dette prima di firmare:
          l'attivazione iniziale e gli interventi straordinari fuori perimetro.
        </p>
      </div>
    </div>
  </section>

  <!-- TRE ARGOMENTI -->
  <section class="band band-surface rule-top">
    <div class="wrap">
      <span class="eyebrow">Perché funziona</span>
      <h2 style="max-width:30ch;">Tre cose che cambiano rispetto al tuo fornitore di oggi</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>Il canone non si misura a postazione</h3>
          <p>
            Non contiamo i PC né gli utenti. Guardiamo di cosa ha bisogno il tuo
            studio e costruiamo un pacchetto su quello: il canone è uno, e resta
            quello anche quando arriva un collaboratore in più.
          </p>
        </div>
        <div class="card">
          <h3>Parti subito, senza investire</h3>
          <p>
            Computer, server, firewall, centralino: tutto a noleggio operativo.
            Nessun acquisto da mettere a bilancio, nessuna analisi lunga mesi
            prima di vedere qualcosa funzionare.
          </p>
        </div>
        <div class="card">
          <h3>Un appuntamento basta</h3>
          <p>
            Non ti serve un audit da tremila euro per sapere quanto spendi. Un
            incontro di raccolta requisiti, e ricevi un preventivo con il canone
            e l'elenco preciso di cosa comprende.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SETTORI -->
  <section class="band">
    <div class="wrap">
      <span class="eyebrow">Settori</span>
      <h2 style="max-width:34ch;">Ogni studio ha problemi che gli altri non hanno</h2>
      <p class="section-intro" style="margin-top:1.1rem;">
        Un poliambulatorio e uno studio commercialista usano gli stessi computer
        e hanno esigenze opposte. Per questo i pacchetti li costruiamo per
        categoria, con dentro anche gli strumenti che servono a quel mestiere e a
        nessun altro.
      </p>
      <div class="grid grid-3">
        {settori.map((s) => (
          <a class="card" href={s.href}>
            <h3>{s.titolo}</h3>
            <p>{s.testo}</p>
            <span class="more">Vedi il pacchetto</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTOMAZIONI -->
  <section class="band band-surface rule-top">
    <div class="wrap">
      <div class="split" style="margin-top:0;">
        <div>
          <span class="eyebrow">Oltre l'informatica</span>
          <h2>Le automazioni che ti fanno guadagnare tempo, o smettere di perdere lavoro</h2>
          <p class="section-intro" style="margin-top:1.2rem;">
            Un fornitore IT normale ti tiene in piedi i computer. Noi mettiamo
            anche gli strumenti che riducono il lavoro ripetitivo della
            segreteria e ti evitano di perdere trattative per una chiamata senza
            risposta. Fanno parte del canone come tutto il resto.
          </p>
          <div class="actions">
            <a class="btn-quiet" href="/servizi">Tutto quello che gestiamo</a>
          </div>
        </div>
        <div>
          <ul class="plain-list">
            <li><strong>Appuntamenti e promemoria automatici</strong> — conferme e richiami senza che nessuno debba telefonare a uno a uno.</li>
            <li><strong>Risponditore intelligente</strong> — risponde quando siete occupati, raccoglie la richiesta e la smista a chi deve leggerla.</li>
            <li><strong>Chiamate in coda</strong> — nessun tono di occupato: chi chiama resta in linea e viene richiamato in ordine.</li>
            <li><strong>Preventivi assistiti</strong> — un questionario guidato e un'elaborazione automatica sui tuoi listini, per rispondere a una richiesta il giorno stesso.</li>
            <li><strong>Documenti che si archiviano da soli</strong> — quello che arriva via mail o via scanner finisce dove deve stare, con il nome giusto.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CHI SIAMO, BREVE -->
  <section class="band">
    <div class="wrap wrap-narrow">
      <span class="eyebrow">Chi risponde al telefono</span>
      <h2>Vent'anni di mestiere, dentro una struttura costruita per crescere</h2>
      <p class="section-intro" style="margin-top:1.2rem;">
        Reparto Tecnologico è il servizio di managed IT di
        <strong>Giamor Group S.r.l.</strong> La direzione tecnica è di
        <strong>Mario Giammarco</strong>, che di servizi IT gestiti si occupa da
        oltre vent'anni, prima come professionista e poi dentro realtà
        strutturate. Giamor Group nasce per portare quella competenza su una
        scala più ampia: più capacità tecnica, copertura su tutto il territorio
        nazionale e un contratto solo, con noi, qualunque sia la città in cui hai
        lo studio.
      </p>
      <div class="pill-row">
        <span class="pill">Un solo contratto</span>
        <span class="pill">Un solo interlocutore</span>
        <span class="pill">Tempi di intervento scritti</span>
        <span class="pill">Copertura nazionale</span>
      </div>
      <div class="actions">
        <a class="btn-quiet" href="/chi-siamo">Chi siamo</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
